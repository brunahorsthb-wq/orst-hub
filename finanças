async function loadAdminUsers(){
  if(window.ORST.role!=='admin'){ return; }
  const users = await window.loadAllUsers();
  const body = document.getElementById('admin-users-body');
  body.innerHTML='';
  if(!users.length){ body.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--text3)">Nenhum usuário encontrado</td></tr>'; return; }
  users.forEach(u=>{
    body.innerHTML+=`<tr>
      <td>${u.email||'—'}</td>
      <td><span class="badge ${u.role==='admin'?'ba':u.role==='premium'?'bp':'bb'}">${u.role||'free'}</span></td>
      <td>
        <select id="role-sel-${u.uid}" class="form-select2" style="width:auto;font-size:12px">
          <option value="free" ${u.role==='free'?'selected':''}>free</option>
          <option value="premium" ${u.role==='premium'?'selected':''}>premium</option>
          <option value="admin" ${u.role==='admin'?'selected':''}>admin</option>
        </select>
      </td>
      <td><button class="btn btn-success" style="font-size:11px;padding:4px 10px" onclick="updateRole('${u.uid}')">Salvar</button></td>
    </tr>`;
  });
}

async function updateRole(uid){
  const newRole = document.getElementById('role-sel-'+uid).value;
  try {
    await window.ORST.updateUserRole(uid, newRole);
    alert('Role atualizado para: ' + newRole);
    loadAdminUsers();
  } catch(e){ alert('Erro ao atualizar: '+e.message); }
}

