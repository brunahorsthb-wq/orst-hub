  });

  const aCtx = document.getElementById('anualChart').getContext('2d');
  anualChart = new Chart(aCtx,{
    type:'bar',
    data:{
      labels:['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'],
      datasets:[
        {label:'Entradas',data:[6800,7200,7900,8400,0,0,0,0,0,0,0,0],backgroundColor:'rgba(26,140,94,0.75)',borderRadius:4},
        {label:'Saídas',data:[4900,5100,4800,5230,0,0,0,0,0,0,0,0],backgroundColor:'rgba(201,64,64,0.65)',borderRadius:4}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.parsed.y)}}},
      scales:{x:{grid:{display:false},ticks:{font:{size:11}}},
              y:{grid:{color:'rgba(0,0,0,0.04)'},ticks:{font:{size:11},callback:v=>v?'R$'+Math.round(v/1000)+'k':''}}}}
  });
}

function updateCharts(entradas, saidas, doMes){
  // Pie por categoria
  const cats = {};
  doMes.filter(l=>l.tipo==='Saída').forEach(l=>{ cats[l.cat]=(cats[l.cat]||0)+l.valor; });
  const catKeys = Object.keys(cats);
  pieChart.data.labels = catKeys.length ? catKeys : ['Sem dados'];
  pieChart.data.datasets[0].data = catKeys.length ? catKeys.map(k=>cats[k]) : [1];
  pieChart.data.datasets[0].backgroundColor = COLORS.slice(0,Math.max(catKeys.length,1));
  pieChart.update();
  // Legend
  const leg = document.getElementById('pie-legend');
  leg.innerHTML = catKeys.length ? catKeys.map((k,i)=>`
    <div style="display:flex;align-items:center;justify-content:space-between">
      <span style="display:flex;align-items:center;gap:5px">
        <span style="width:8px;height:8px;border-radius:50%;background:${COLORS[i]};flex-shrink:0"></span>${k}
      </span>
      <span style="color:var(--text2);font-weight:500">${fmt(cats[k])}</span>
    </div>`).join('') : '<div style="color:var(--text3)">Sem saídas este mês</div>';
}

