        {label:'Saídas',data:[4900,5100,4800,5230],borderColor:'#c94040',backgroundColor:'rgba(201,64,64,0.05)',tension:0.4,pointBackgroundColor:'#c94040',pointRadius:4,fill:true,borderWidth:2,borderDash:[5,4]}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.parsed.y)}}},
      scales:{x:{grid:{color:'rgba(0,0,0,0.04)'},ticks:{font:{size:11}}},
              y:{grid:{color:'rgba(0,0,0,0.04)'},ticks:{font:{size:11},callback:v=>'R$'+Math.round(v/1000)+'k'}}}}
  });

  const pCtx = document.getElementById('pieChart').getContext('2d');
  pieChart = new Chart(pCtx,{
    type:'doughnut',
