function renderLancamentos(){
  const tipo   = document.getElementById('f-tipo').value;
  const cat    = document.getElementById('f-cat').value;
  const status = document.getElementById('f-status').value;
  const data   = lancamentos;
  const filtered = data.filter(l=>
    (!tipo||l.tipo===tipo) && (!cat||l.cat===cat) && (!status||l.status===status)
  );
  document.getElementById('lanc-count').textContent = filtered.length + ' transações';
  const list = document.getElementById('lanc-list');
  list.innerHTML = '';
  if(!filtered.length){ list.innerHTML='<div style="text-align:center;padding:20px;color:var(--text3)">Nenhuma transação encontrada</div>'; return; }
  filtered.forEach(l=>{
    const pos = l.tipo==='Entrada';
    const bc = l.status==='Pago'?'bg':l.status==='Pendente'?'ba':'br';
    list.innerHTML += `<div class="tx-item">
      <div class="tx-left">
        <div class="tx-av" style="background:${pos?'var(--green-bg)':'var(--red-bg)'};font-size:14px">${pos?'↑':'↓'}</div>
        <div><div class="tx-name">${l.desc}</div><div class="tx-det">${l.data} · ${l.inst} · ${l.forma} · ${l.cat}</div></div>
      </div>
      <div class="tx-right">
        <span class="badge ${bc}">${l.status}</span>
        <div class="tx-val ${pos?'pos':'neg'}">${pos?'+':'-'}${fmt(l.valor)}</div>
        <button onclick="delLanc('${l.id}')" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:18px;padding:0 2px">×</button>
      </div>
    </div>`;
  });
}

async function addLancamento(){
  const desc  = document.getElementById('n-desc').value.trim();
  const valor = parseFloat(document.getElementById('n-valor').value);
  const err   = document.getElementById('modal-lanc-error');
  if(!desc||!valor||valor<=0){ err.textContent='Preencha descrição e valor.'; return; }
  err.textContent='';
  const lanc = {
    data: document.getElementById('n-data').value || new Date().toISOString().slice(0,10),
    tipo: document.getElementById('n-tipo').value,
    cat:  document.getElementById('n-cat').value,
    valor, desc,
    forma: document.getElementById('n-forma').value,
    inst:  document.getElementById('n-inst').value,
    status: document.getElementById('n-status').value,
    ts: new Date().toISOString()
  };
  try {
    const ref = await window.saveLancamento(lanc);
    lanc.id = ref?.id || 'local-'+Date.now();
  } catch(e) { lanc.id = 'local-'+Date.now(); }
  lancamentos.unshift(lanc);
  closeModal('modal-lancamento');
  renderLancamentos();
  loadDashboard();
}

async function delLanc(id){
  if(!confirm('Excluir esta transação?')) return;
  try { await window.deleteLancamentoFS(id); } catch(e){}
  lancamentos = lancamentos.filter(l=>l.id!==id);
  renderLancamentos();
  loadDashboard();
}

// ===== PARCELADAS =====
let parceladas = [];

async function loadParceladas(){
  try {
    parceladas = await window.getParceladas();
  } catch(e) { parceladas = []; }
}

function gerarParcelas(total, qtd, dataInicial){
  const parcelaVal = total / qtd;
  const parcelas = [];
  const base = new Date(dataInicial);
  for(let i=0; i<qtd; i++){
    const d = new Date(base);
    d.setMonth(d.getMonth() + i);
    parcelas.push({
      num: i+1,
      data: d.toISOString().slice(0,10),
      valor: parcelaVal,
      status: 'Pendente'
    });
  }
  return parcelas;
}

function calcParcela(){
  const total = parseFloat(document.getElementById('p-total').value)||0;
  const qtd   = parseInt(document.getElementById('p-qtd').value)||0;
  const preview = document.getElementById('p-preview');
  if(total>0 && qtd>1){
    document.getElementById('p-val-calc').textContent = fmt(total/qtd);
    preview.style.display = '';
  } else { preview.style.display = 'none'; }
}

async function addParcelada(){
  const nome  = document.getElementById('p-nome').value.trim();
  const total = parseFloat(document.getElementById('p-total').value);
  const qtd   = parseInt(document.getElementById('p-qtd').value);
  const data  = document.getElementById('p-data').value;
  const err   = document.getElementById('modal-parc-error');
  if(!nome||!total||!qtd||qtd<2){ err.textContent='Preencha todos os campos. Mínimo 2 parcelas.'; return; }
  err.textContent='';
  const obj = {
    nome, total, qtd,
    dataInicial: data,
    cat:  document.getElementById('p-cat').value,
    inst: document.getElementById('p-inst').value,
    parcelas: gerarParcelas(total, qtd, data),
    criadoEm: new Date().toISOString()
  };
  try {
    const ref = await window.saveParcelada(obj);
    obj.id = ref?.id || 'local-'+Date.now();
  } catch(e) { obj.id = 'local-'+Date.now(); }
  parceladas.push(obj);
  closeModal('modal-parcelada');
  renderParceladas();
  loadDashboard();
}

async function toggleParcela(parceladaId, idx, currentStatus){
  const newStatus = currentStatus==='Pago' ? 'Pendente' : 'Pago';
  const p = parceladas.find(x=>x.id===parceladaId);
  if(!p) return;
  p.parcelas[idx].status = newStatus;
  try { await window.updateParcelaStatus(parceladaId, idx, newStatus); } catch(e){}
  renderParceladas();
  loadDashboard();
}

async function delParcelada(id){
  if(!confirm('Excluir este parcelamento completo?')) return;
  try { await window.deleteParceladaFS(id); } catch(e){}
  parceladas = parceladas.filter(p=>p.id!==id);
  renderParceladas();
  loadDashboard();
}

function renderParceladas(){
  const list = document.getElementById('parceladas-list');
  const mes = parseInt(document.getElementById('month-sel').value);
  let totalGeral=0, totalMes=0;
  list.innerHTML='';
  if(!parceladas.length){
    list.innerHTML='<div style="text-align:center;padding:30px;color:var(--text3)">Nenhuma despesa parcelada. Clique em "+ Nova parcelada".</div>';
    document.getElementById('parc-total').textContent='R$ 0';
    document.getElementById('parc-mes').textContent='R$ 0';
    document.getElementById('parc-qtd').textContent='0';
    return;
  }
  parceladas.forEach(p=>{
    totalGeral += p.total;
    const pagas = p.parcelas.filter(x=>x.status==='Pago').length;
    const pctPago = Math.round((pagas/p.qtd)*100);
    let bodyHtml = '';
    p.parcelas.forEach((parc,i)=>{
      const pMes = new Date(parc.data).getMonth();
      if(pMes===mes) totalMes += parc.valor;
      const pago = parc.status==='Pago';
      bodyHtml += `<div class="parcela-item">
        <span class="parcela-num">${parc.num}/${p.qtd}</span>
        <span class="parcela-data">${parc.data}</span>
        <span class="parcela-val ${pago?'':'neg'}">${fmt(parc.valor)}</span>
        <span class="badge ${pago?'bg':'ba'}">${parc.status}</span>
        <button class="btn parcela-toggle" style="font-size:11px;padding:3px 8px" onclick="toggleParcela('${p.id}',${i},'${parc.status}')">
          ${pago?'Desfazer':'Marcar pago'}
        </button>
      </div>`;
    });
    list.innerHTML += `<div class="parcela-group">
      <div class="parcela-header" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'':'none'">
        <div>
          <div class="parcela-name">${p.nome} <span class="badge bb">${p.cat}</span></div>
          <div class="parcela-info">${pagas}/${p.qtd} pagas · ${fmt(p.total/p.qtd)}/mês · Total: ${fmt(p.total)}</div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:80px">
            <div class="pbar"><div class="pfill" style="width:${pctPago}%;background:var(--blue)"></div></div>
            <div style="font-size:10px;color:var(--text3);text-align:right;margin-top:2px">${pctPago}%</div>
          </div>
          <button class="btn btn-danger" style="font-size:11px;padding:4px 8px" onclick="event.stopPropagation();delParcelada('${p.id}')">Excluir</button>
        </div>
      </div>
      <div class="parcela-body" style="display:none">${bodyHtml}</div>
    </div>`;
  });
  document.getElementById('parc-total').textContent = fmt(totalGeral);
  document.getElementById('parc-mes').textContent = fmt(totalMes);
  document.getElementById('parc-qtd').textContent = parceladas.length;
}

