async function addMeta(){
  const nome  = document.getElementById('m-nome').value.trim();
  const alvo  = parseFloat(document.getElementById('m-alvo').value);
  const atual = parseFloat(document.getElementById('m-atual').value)||0;
  const cor   = document.getElementById('m-cor').value;
  if(!nome||!alvo){ alert('Preencha nome e valor alvo.'); return; }
  const m = {nome,alvo,atual,cor,criadoEm:new Date().toISOString()};
  try { const ref=await window.saveMeta(m); m.id=ref?.id||'m-'+Date.now(); } catch(e){ m.id='m-'+Date.now(); }
  metas.push(m);
  closeModal('modal-meta');
  renderMetas();
}

// ===== DASHBOARD =====
async function loadDashboard(){
  if(!lancamentos.length) await loadLancamentos();
  if(!parceladas.length)  await loadParceladas();
  const mes = parseInt(document.getElementById('month-sel').value);
  const doMes = lancamentos.filter(l => new Date(l.data).getMonth()===mes);
  const entradas = doMes.filter(l=>l.tipo==='Entrada').reduce((a,l)=>a+l.valor,0);
  const saidas   = doMes.filter(l=>l.tipo==='Saída').reduce((a,l)=>a+l.valor,0);
  const saldo    = entradas - saidas;
  // Parcelas do mês
  let parcMes = 0;
  parceladas.forEach(p=>{
    p.parcelas?.forEach(pa=>{
      if(new Date(pa.data).getMonth()===mes && pa.status==='Pendente') parcMes += pa.valor;
    });
  });
  document.getElementById('d-entradas').textContent = fmt(entradas);
  document.getElementById('d-saidas').textContent   = fmt(saidas);
  document.getElementById('d-saldo').textContent    = fmt(saldo);
  document.getElementById('d-parcelas').textContent = fmt(parcMes);

  // Últimas tx
  const dashTx = document.getElementById('dash-tx');
  dashTx.innerHTML='';
  lancamentos.slice(0,6).forEach(l=>{
    const pos = l.tipo==='Entrada';
    dashTx.innerHTML+=`<div class="tx-item">
      <div class="tx-left">
        <div class="tx-av" style="background:${pos?'var(--green-bg)':'var(--red-bg)'};font-size:14px">${pos?'↑':'↓'}</div>
        <div><div class="tx-name">${l.desc}</div><div class="tx-det">${l.cat} · ${l.inst}</div></div>
      </div>
      <div class="tx-val ${pos?'pos':'neg'}">${pos?'+':'-'}${fmt(l.valor)}</div>
    </div>`;
  });
  if(!lancamentos.length) dashTx.innerHTML='<div style="text-align:center;padding:20px;color:var(--text3)">Nenhuma transação este mês. Clique em "+ Lançamento".</div>';
  updateCharts(entradas, saidas, doMes);
}

