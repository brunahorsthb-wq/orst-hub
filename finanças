function renderMetas(){
  const el = document.getElementById('metas-list');
  el.innerHTML='';
  if(!metas.length){ el.innerHTML='<div style="text-align:center;padding:30px;color:var(--text3)">Nenhuma meta criada.</div>'; return; }
  metas.forEach(m=>{
    const pct = Math.min(100,Math.round((m.atual/m.alvo)*100));
    el.innerHTML += `<div class="goal-item">
      <div class="goal-top">
        <span class="goal-name">${m.nome}</span>
