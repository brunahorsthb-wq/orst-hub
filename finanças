    {id:'d3',data:'2025-04-10',tipo:'Saída',cat:'Alimentação',desc:'Supermercado',valor:380,forma:'Crédito',inst:'Nubank',status:'Pago'},
    {id:'d4',data:'2025-04-12',tipo:'Entrada',cat:'Receita',desc:'Freelance',valor:900,forma:'Pix',inst:'Nubank',status:'Pago'},
    {id:'d5',data:'2025-04-20',tipo:'Saída',cat:'Transporte',desc:'Combustível',valor:180,forma:'Débito',inst:'Nubank',status:'Pago'},
    {id:'d6',data:'2025-04-25',tipo:'Entrada',cat:'Receita',desc:'Dividendos',valor:300,forma:'Crédito',inst:'Sicoob',status:'Pago'},
    {id:'d7',data:'2025-04-30',tipo:'Saída',cat:'Outros',desc:'Internet',valor:120,forma:'Débito',inst:'Mercado Pago',status:'Pendente'},
