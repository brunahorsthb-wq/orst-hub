      <div class="goal-bot">
        <span>${fmt(m.atual)} acumulados · faltam ${fmt(m.alvo-m.atual)}</span>
        <span style="color:${m.cor};font-weight:500">${pct}%</span>
      </div>
    </div>`;
  });
